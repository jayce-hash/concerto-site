# ── Concerto: the app IS the website ────────────────────────────────
# One surface. The static /venues/* and /tours/* guide pages are gone;
# every venue and tour URL now serves the app's detail screen at the
# singular path. The 301s below carry the old URLs across.

# Legacy
# events.tsx retired -- /near-me is the single Near Me screen. A 301
# carries the old URL's ranking history across.
/events       /near-me   301
/events.html  /near-me   301
/mobile-bags.html   /mobile-bagcheck.html   301
/mobile-bags        /mobile-bagcheck        301

# Concerto+ is a FEATURE (the night planner); the paid tier is Premium.
/concertoplus       /premium   301
/concertoplus.html  /premium   301

# Retired surfaces -- files deleted so these actually fire. Passport
# (formerly Live Mode) is retired entirely.
/passport               /          301
/passport.html          /          301
/livemode               /          301
/livemode.html          /          301
/shop                   /premium           301
/shop.html              /premium           301
/mobile-livemode        /mobile-account    301
/mobile-livemode.html   /mobile-account.html   301

# Retired tour. Must sit above the /tours/* splat so it wins.
/tours/fifa-world-cup-2026   /tours   301

# The plural guide URLs are retired. Every old /venues/{slug} and
# /tours/{slug} 301s to the app screen at the singular path. The
# hubs /venues and /tours are untouched (splats don't match the bare
# path) and keep serving the app's tab pages.
/venues/*   /venue/:splat   301
/tours/*    /tour/:splat    301

# The app's detail screens: any slug rewrites to the exported shell.
/venue/*   /venue/[slug].html   200
/tour/*    /tour/[slug].html    200

